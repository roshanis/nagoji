        "light_fraction": 1.0
      },
      {
        "frame_id": "page-07-panel-02",
        "text": "your people?",
        "source_pixel_rect": [
          1106,
          345,
          1289,
          388
        ],
        "light_fraction": 1.0
      },
      {
        "frame_id": "page-07-panel-03",

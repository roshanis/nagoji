          1106,
          141,
          1826,
          184
        ],
        "light_fraction": 1.0
      },
      {
        "frame_id": "page-07-panel-02",
        "text": "me.",
        "source_pixel_rect": [
          1106,
          202,
          1158,
          225
        ],
        "light_fraction": 1.0
      },
      {
        "frame_id": "page-07-panel-02",
        "text": "Do you believe you fight for God, for some higher",
        "source_pixel_rect": [
          1106,
          243,
          1795,
          286
        ],
        "light_fraction": 1.0
      },
      {
        "frame_id": "page-07-panel-02",

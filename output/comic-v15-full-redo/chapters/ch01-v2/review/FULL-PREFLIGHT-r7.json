        "text": "But you can speak your questions.",
        "source_pixel_rect": [
          82,
          240,
          609,
          285
        ],
        "light_fraction": 1.0
      },
      {
        "frame_id": "page-03-panel-03",
        "text": "I have heard most of them already.",
        "source_pixel_rect": [
          82,
          295,
          615,
          341
        ],
        "light_fraction": 1.0
      },

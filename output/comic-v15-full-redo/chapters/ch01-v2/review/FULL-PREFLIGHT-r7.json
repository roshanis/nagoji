        "source_pixel_rect": [
          101,
          220,
          570,
          270
        ],
        "light_fraction": 1.0
      },
      {
        "frame_id": "page-01-panel-03",
        "text": "Here I was a number.",
        "source_pixel_rect": [
          47,
          92,
          505,
          141
        ],
        "light_fraction": 1.0
      },
      {
        "frame_id": "page-01-panel-04",

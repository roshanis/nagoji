        "source_pixel_rect": [
          141,
          170,
          780,
          213
        ],
        "light_fraction": 1.0
      },
      {
        "frame_id": "page-06-panel-01",
        "text": "What we do not know is who ordered the attacks,",
        "source_pixel_rect": [
          141,
          223,
          851,
          259
        ],
        "light_fraction": 1.0
      },
      {
        "frame_id": "page-06-panel-01",
        "text": "how many men you had, and which forts you meant",

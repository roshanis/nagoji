        "source_pixel_rect": [
          896,
          295,
          1807,
          345
        ],
        "light_fraction": 1.0
      },
      {
        "frame_id": "page-07-panel-04",
        "text": "I fight because I was born into a world where men who",
        "source_pixel_rect": [
          205,
          143,
          948,
          184
        ],
        "light_fraction": 1.0
      },
      {
        "frame_id": "page-07-panel-04",

      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-05",
      "text": "were sacks of pepper.",
      "source_pixel_rect": [
        1129,
        325,
        1447,
        368
      ],
      "light_fraction": 0.9984642387011847
    },
    {
      "frame_id": "page-05-panel-05",
      "text": "Pray for their health,",
      "source_pixel_rect": [
        1603,
        129,
        1896,
        171

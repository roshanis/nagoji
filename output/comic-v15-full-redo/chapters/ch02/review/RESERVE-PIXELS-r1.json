      "frame_id": "page-05-panel-02",
      "text": "scraped that away.",
      "source_pixel_rect": [
        751,
        571,
        1081,
        622
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-03",
      "text": "We are not there yet. As",

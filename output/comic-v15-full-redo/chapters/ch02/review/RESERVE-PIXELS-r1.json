      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-05",
      "text": "not their souls.",
      "source_pixel_rect": [
        1603,
        181,
        1815,
        214
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-06-panel-01",
      "text": "If there is a storm, will the",
      "source_pixel_rect": [

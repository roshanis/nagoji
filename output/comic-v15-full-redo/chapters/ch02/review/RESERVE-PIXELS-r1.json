  "lines": [
    {
      "frame_id": "page-01-panel-01",
      "text": "They woke us under cover of bells.",
      "source_pixel_rect": [
        39,
        40,
        552,
        84
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-01-panel-01",
      "text": "I counted the strokes.",
      "source_pixel_rect": [
        717,
        45,
        1036,
        79
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-01-panel-01",
      "text": "Up! Those marked go to the docks.",
      "source_pixel_rect": [
        1501,
        56,
        2011,
        99
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-01-panel-02",
      "text": "The same hymn the bells had played.",
      "source_pixel_rect": [
        665,
        65,
        1477,
        130
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-01-panel-03",
      "text": "He knew where I sat. He had spent too many hours standing over",
      "source_pixel_rect": [
        55,
        38,
        1369,
        98
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-01-panel-03",
      "text": "me.",
      "source_pixel_rect": [
        55,
        124,
        130,
        158
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-01-panel-03",
      "text": "On your feet, marata. The Viceroy has found",
      "source_pixel_rect": [
        475,
        230,
        1360,
        291
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-01-panel-03",
      "text": "a use for you.",
      "source_pixel_rect": [
        475,
        304,
        750,
        364
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-01-panel-04",
      "text": "My legs swung free, terrifyingly light.",
      "source_pixel_rect": [
        46,
        21,
        837,
        85
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-01-panel-04",
      "text": "I forced myself not to limp.",
      "source_pixel_rect": [
        1034,
        22,
        1601,
        84
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-01-panel-05",
      "text": "Keshavrao. One of my riders.",
      "source_pixel_rect": [
        61,
        33,
        479,
        75
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-01-panel-05",
      "text": "Rao.",
      "source_pixel_rect": [
        1751,
        41,
        1814,
        74
      ],
      "light_fraction": 1.0
    },
    {

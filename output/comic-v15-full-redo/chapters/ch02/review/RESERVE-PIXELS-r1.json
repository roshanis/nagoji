        32,
        26,
        565,
        92
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-03",
      "text": "long as we move, there is a",
      "source_pixel_rect": [
        32,
        107,
        645,
        173
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-03",
      "text": "chance.",
      "source_pixel_rect": [
        32,
        188,
        209,
        240
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-03",
      "text": "The sahib still counts chances.",
      "source_pixel_rect": [
        729,
        31,
        1417,
        82
      ],
      "light_fraction": 1.0
    },

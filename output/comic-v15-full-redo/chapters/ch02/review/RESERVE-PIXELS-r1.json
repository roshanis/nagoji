      "frame_id": "page-05-panel-03",
      "text": "It is what I know.",
      "source_pixel_rect": [
        1517,
        58,
        1898,
        109
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-04",
      "text": "Time on a ship is different from time on land.",
      "source_pixel_rect": [
        39,
        33,
        1043,
        99
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-04",
      "text": "Wind is with us. If it holds",
      "source_pixel_rect": [
        1485,
        117,
        2061,
        169
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-04",
      "text": "we round the cape before",
      "source_pixel_rect": [
        1485,
        198,
        2060,
        264
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-04",
      "text": "the worst of the storms.",
      "source_pixel_rect": [
        1484,
        279,
        2016,
        331
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-05",
      "text": "This run is cursed. They",
      "source_pixel_rect": [
        581,
        21,
        921,
        63
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-05",
      "text": "say God sends warnings.",
      "source_pixel_rect": [
        581,
        72,
        938,
        115
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-05",
      "text": "God sends opportunity.",
      "source_pixel_rect": [
        1096,
        33,
        1424,
        75
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-05",
      "text": "These bodies are silver if",
      "source_pixel_rect": [
        1096,
        85,
        1454,
        118
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-05",
      "text": "they live.",
      "source_pixel_rect": [
        1095,
        136,
        1224,
        178
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-05",
      "text": "He named a number of",
      "source_pixel_rect": [
        1129,
        222,
        1453,
        255
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-05",
      "text": "cruzados per head, as if we",
      "source_pixel_rect": [
        1129,
        274,
        1522,
        316

      "frame_id": "page-05-panel-02",
      "text": "shoot the song out of",
      "source_pixel_rect": [
        743,
        228,
        1106,
        280
      ],
      "light_fraction": 1.0
    },
    {
      "frame_id": "page-05-panel-02",
      "text": "his mouth.",
